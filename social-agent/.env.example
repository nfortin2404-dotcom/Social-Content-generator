# ============================================================
# SOCIAL CONTENT AGENT - Configuration
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# Claude AI (Anthropic)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# ---- META (Facebook + Instagram) --------------------------
# https://developers.facebook.com/
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_long_lived_access_token

# IDs de vos pages/comptes Meta
FACEBOOK_PAGE_ID=your_facebook_page_id
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_account_id

# ---- TIKTOK -----------------------------------------------
# https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_OPEN_ID=your_tiktok_open_id

# ---- GÉNÉRATION D'IMAGES ----------------------------------
# Stability AI (optionnel, pour générer des images)
# https://platform.stability.ai/
STABILITY_API_KEY=your_stability_api_key

# ---- PARAMÈTRES GÉNÉRAUX ----------------------------------
# Langue principale du contenu (fr, en, es, etc.)
CONTENT_LANGUAGE=fr

# Fuseau horaire pour la planification
TIMEZONE=America/Montreal

# Nombre de posts par plateforme par jour (min: 3)
POSTS_PER_DAY=3

# Répertoire de stockage des médias
MEDIA_DIR=./data/media
